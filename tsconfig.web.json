{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/web",
    "src/lexicon",
    "lexicons",
    "tests/ui",
    "tests/web",
    "tests/e2e",
    "playwright.config.ts",
    "vite.config.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
