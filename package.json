{
  "name": "shinchoku-chan",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-port.mjs 8787 && mkdir -p dist/web",
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "typecheck": "tsc && tsc -p tsconfig.web.json",
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run",
    "setup:spec": "npm ci --ignore-scripts --prefix .claude/skills/spec-driven-development/scripts",
    "lint:spec": "prettier --check specs docs \"poc/**/README.md\" && node .claude/skills/spec-driven-development/scripts/check-all.mjs",
    "test:spec": "node .claude/skills/spec-driven-development/scripts/selftest.mjs",
    "build": "vite build && node scripts/check-size.mjs",
    "test:e2e": "playwright test",
    "check:ui": "node scripts/check-css-tokens.mjs && node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "jsdom": "^29.1.1",
    "prettier": "3.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@atproto/lex-json": "^0.1.7",
    "@atproto/lexicon": "^0.7.17",
    "@ipld/dag-cbor": "^10.0.2",
    "multiformats": "^14.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
