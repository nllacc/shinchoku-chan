{
  "lexicon": 1,
  "id": "com.example.shinchoku.bot.receipt",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["subject", "checkin", "status", "receivedAt"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did"
          },
          "checkin": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "status": {
            "type": "string",
            "knownValues": ["accepted", "expired"],
            "maxLength": 20
          },
          "record": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "value": {
            "type": "integer"
          },
          "receivedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
