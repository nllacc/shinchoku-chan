{
  "lexicon": 1,
  "id": "com.example.shinchoku.result",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "task",
          "checkin",
          "finalValue",
          "description",
          "createdAt"
        ],
        "properties": {
          "task": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "checkin": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "finalValue": { "type": "integer" },
          "description": {
            "type": "string",
            "maxGraphemes": 500,
            "maxLength": 2500
          },
          "evidence": {
            "type": "blob",
            "accept": ["image/jpeg", "image/png", "image/webp"],
            "maxSize": 1000000
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
